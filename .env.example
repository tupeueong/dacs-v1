# Sao chép thành .env trên máy chạy. Không commit .env thật.
# OpenRouter API (model Gemma 26B Free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.8-27b:free


LEGAL_RAG_INDEX_ROOT=legal_data/vectorstore_versions
LEGAL_RAG_CURRENT_POINTER=legal_data/vectorstore_versions/current.json
LEGAL_RAG_EMBED_MODEL=truro7/vn-law-embedding
LEGAL_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
LEGAL_RAG_MIN_RERANK_SCORE=0.05
LEGAL_RAG_MAX_CONTEXT_TOKENS=12000

